# Copy to .env and adjust for the environment.
DEMO_MODE=true
JWT_SECRET=replace-with-a-long-random-string
DATA_FILE=.data/store.json
PERSIST=true
LOG_LEVEL=INFO
# Optional device gateway credential (X-Device-Key)
DEVICE_API_KEY=demo-device-key-change-me
# Restrict browser origins in production, e.g. https://console.example.com
CORS_ORIGINS=*
